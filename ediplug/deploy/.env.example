# EDIPLUG AS2 node environment. Copy to .env, fill in, then: chmod 600 .env
# Never commit the real .env. Everything else (OpenAS2 config, nginx config) is in the image / this folder.

# ---- Image (AWS ECR) ----
OPENAS2_IMAGE=<account-id>.dkr.ecr.<region>.amazonaws.com/ediplug-openas2:4.15.0-ediplug-s5

# ---- PostgreSQL (AWS RDS) ----
AS2_DB_HOST=<rds-endpoint>.<region>.rds.amazonaws.com
AS2_DB_PORT=5432
AS2_DB_NAME=openas2
AS2_DB_USER=openas2
AS2_DB_PASSWORD=<openas2 role password>
# RDS: verify-full with the AWS bundle baked into the image. Self-hosted Postgres with its own CA: verify-ca + db-ca.pem
AS2_DB_SSLMODE=verify-full
AS2_DB_SSLROOTCERT=/opt/openas2/config/rds-global-bundle.pem

# ---- Keys ----
# Passphrase of the encrypted private keys stored in as2_own_key. Must be the value the keys were encrypted with.
AS2_KEY_ENCRYPTION_PASSWORD=<long random passphrase>
# Protects entries of the in-memory keystore only (any long random value)
AS2_KEYSTORE_PASSWORD=<long random value>

# ---- Error alert email (logback SMTP appender, STARTTLS) ----
SMTP_HOST=<smtp host>
SMTP_PORT=587
SMTP_USER=<smtp user>
SMTP_PASS=<smtp password>

# ---- Optional ----
OPENAS2_LOG_LEVEL=INFO
