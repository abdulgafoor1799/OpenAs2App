# EDIPLUG AS2 node environment. Copy to .env, fill in, then: chmod 600 .env
# Never commit the real .env. Everything else (OpenAS2 config, nginx config) is in the image / this folder.

# ---- Image (AWS ECR) ----
# scripts/deploy-openas2.sh <tag> sets OPENAS2_IMAGE (and OPENAS2_IMAGE_PREVIOUS) from these; pick the tag that matches
# the CPU: arm64-* for ARM64 hosts (OCI Ampere, AWS Graviton), x86-* for x86-64 hosts.
ECR_REGISTRY=<account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REPOSITORY=openas2-ediplug
AWS_REGION=<region>
# AWS CLI profile with the pull-only key (aws configure --profile ecr-pull)
ECR_AWS_PROFILE=ecr-pull
# HA setup: credentials file on the shared storage instead of ~/.aws (mode 600), e.g.
#ECR_AWS_CREDENTIALS_FILE=/mnt/ediplug-shared/secrets/aws-credentials
OPENAS2_IMAGE=<account-id>.dkr.ecr.<region>.amazonaws.com/openas2-ediplug:arm64-v2

# ---- Public name (docker-compose.tls.yml: nginx server_name; also set as2_async_mdn_url in override/) ----
AS2_PUBLIC_HOSTNAME=<hostname, e.g. as2-test.ediplug.com>

# ---- PostgreSQL (AWS RDS) ----
AS2_DB_HOST=<rds-endpoint>.<region>.rds.amazonaws.com
AS2_DB_PORT=5432
AS2_DB_NAME=openas2-<env>
AS2_DB_USER=openas2_<env>
AS2_DB_PASSWORD=<openas2 role password>
# RDS: verify-full with the AWS bundle baked into the image. Self-hosted Postgres with its own CA: mount that CA PEM
# into the container and point AS2_DB_SSLROOTCERT at it. Local test database without TLS: AS2_DB_SSLMODE=disable
AS2_DB_SSLMODE=verify-full
AS2_DB_SSLROOTCERT=/opt/openas2/config/rds-global-bundle.pem

# ---- Keys ----
# Passphrase of the encrypted private keys stored in as2_own_key. Must be the value the keys were encrypted with.
AS2_KEY_ENCRYPTION_PASSWORD=<long random passphrase>
# Protects entries of the in-memory keystore only (any long random value)
AS2_KEYSTORE_PASSWORD=<long random value>

# ---- Error alert email (logback SMTP appender, STARTTLS) ----
SMTP_HOST=<smtp host>
SMTP_PORT=587
SMTP_USER=<smtp user>
SMTP_PASS=<smtp password>

# ---- Optional ----
OPENAS2_LOG_LEVEL=INFO
# Runtime openas2.properties in ./override: merge (your keys over the image's) or replace (your file only)
OPENAS2_PROPERTIES_OVERRIDE_MODE=merge

# ---- Paths (docker-compose.tls.yml). Defaults are folders next to docker-compose.yml; the HA setup points them at
# the FSS mount (scripts/setup-node.sh --shared sets them, plus COMPOSE_FILE) ----
#AS2_DATA_DIR=/mnt/ediplug-shared/data
#AS2_CERTS_DIR=/mnt/ediplug-shared/certs
#AS2_OVERRIDE_DIR=/mnt/ediplug-shared/config/override
#COMPOSE_FILE=docker-compose.yml:docker-compose.ha.yml
