<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration>

<configuration scan="true" scanPeriod="30 seconds">
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>

    <import class="ch.qos.logback.core.FileAppender"/>
    <timestamp key="byDay" datePattern="yyyyMMdd"/>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${OPENAS2_LOG_DIR}/log-${byDay}.txt</file>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{60} -%kvp- %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Console output is collected by Docker (docker logs, json-file driver with rotation) -->
    <import class="ch.qos.logback.core.ConsoleAppender"/>
    <appender name="CONSOLE" class="ConsoleAppender">
        <encoder class="PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{60} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ERROR level messages are emailed to support. SMTP settings come from environment variables. -->
    <import class="ch.qos.logback.classic.net.SMTPAppender"/>
    <import class="ch.qos.logback.classic.filter.LevelFilter"/>
    <appender name="EMAIL" class="SMTPAppender">
        <cyclicBufferTracker class="ch.qos.logback.core.spi.CyclicBufferTracker">
            <bufferSize>5</bufferSize>
        </cyclicBufferTracker>
        <filter class="LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <smtpHost>${SMTP_HOST}</smtpHost>
        <smtpPort>${SMTP_PORT}</smtpPort>
        <STARTTLS>true</STARTTLS>
        <username>${SMTP_USER}</username>
        <password>${SMTP_PASS}</password>
        <to>support@ediplug.com</to>
        <from>as2-errors@ediplug.com</from>
        <subject>EDIPLUG AS2 FAILURE ALERT</subject>
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>
        AS2 Failure Alert
        -------------------------------------
        Time:   %d{yyyy-MM-dd HH:mm:ss}
        Thread: %thread
        Source: %logger{20}

        MESSAGE:
        %msg%n
            </pattern>
        </layout>
    </appender>

    <root level="${OPENAS2_LOG_LEVEL:-INFO}">
        <appender-ref ref="FILE" />
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="EMAIL" />
    </root>
</configuration>
